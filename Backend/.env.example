# ==============================================================================
# MediaGuard Sports - Environment Configuration Template (.env.example)
# ==============================================================================

# ── Node.js Orchestrator (Backend/server) ──────────────────────────────────────
NODE_ENV=development
NODE_PORT=8000
CLIENT_URL=http://localhost:5173
FASTAPI_URL=http://127.0.0.1:8001

# Database Persistence
# Defaults to localhost MongoDB; app gracefully falls back to in-memory store if offline
MONGO_URI=mongodb://127.0.0.1:27017/mediaguard

# Caching & Rate Limiting (Optional)
# Defaults to localhost Redis; app gracefully runs without Redis if offline
REDIS_URL=redis://127.0.0.1:6379

# ── Python / FastAPI ML Engine (Backend/) ──────────────────────────────────────
# LLM API Keys (Optional - deterministic legal fallbacks are used if keys are absent)
GROQ_API_KEY=
GEMINI_API_KEY=

# Watchdog Continuous Monitoring
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MIN=360
WATCHDOG_THRESHOLD=50.0

# YouTube Ingest Cookie Authentication (Optional)
# Base64-encoded Netscape format cookie file for bypassing cloud IP bot blocks
YOUTUBE_COOKIES_B64=

# ── Optional Platform API Keys (Unlocks authenticated direct live search) ──────
# Vimeo Personal Access Token (from https://developer.vimeo.com)
VIMEO_ACCESS_TOKEN=
# Reddit App Client ID & Secret (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Twitch Developer Client ID (from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitter / X Bearer Token (from https://developer.twitter.com)
TWITTER_BEARER_TOKEN=
# Meta / Facebook Graph API Token (from https://developers.facebook.com)
FACEBOOK_ACCESS_TOKEN=

# Google Cloud Storage Vault Sync (Optional)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# ── React Frontend (Frontend/) ────────────────────────────────────────────────
# API & WebSocket target URL (defaults to http://localhost:8000)
VITE_API_URL=http://localhost:8000
